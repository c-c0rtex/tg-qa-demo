# run.sh writes the real server/.env itself; this documents the keys it sets.
# The bot token is read from ~/.config/tg-qa/telebook.bot-token (NOT committed).

BOT_TOKEN=            # from @BotFather (stored in ~/.config/tg-qa/telebook.bot-token)
WEB_APP_URL=          # <tunnel>/app/  — set by run.sh
PORT=3400
USE_POLLING=false     # webhook mode (tunnel); true = local polling, no Mini App
FORCE_LISTEN=true     # listen locally without switching to Telegram's test DC (demo patch)
PUBLIC_HOST=          # <tunnel> — webhook base, set by run.sh
PROVIDER_TOKEN=       # empty: payments use Telegram Stars (XTR), no provider token
